{
  "name": "tactical-valorant-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "fetch-assets": "node scripts/fetch-assets.mjs",
    "test": "tsx manager-systems.test.mjs && tsx map-navigation.test.mjs && tsx map-veto.test.mjs && tsx spike-simulation.test.mjs && tsx arena-geometry.test.mjs && tsx training.test.mjs",
    "build-map-navigation": "tsx scripts/map-navigation.mjs --generate",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "fetch-abilities": "node scripts/fetch-abilities.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/three": "^0.186.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.1.0"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
